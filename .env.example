# Supabase Public Configuration (Client-side)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase Private Configuration (Server-side Only)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# First Super Admin Bootstrap Email (Automatically granted super_admin role on first sign-up)
SUPER_ADMIN_EMAIL="admin@ius.edu.ba"

# Site URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Event Attendance Dynamic QR Signing Secret (Min 32 chars)
QR_HMAC_SECRET="change-this-to-a-secure-random-secret-key-32-chars-min"
