# Supabase Public Configuration (Client-side)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase Private Configuration (Server-side Only)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# First super admin: granted on the first sign-in after this mailbox is verified.
# Must be a @student.ius.edu.ba address, because only those can register.
SUPER_ADMIN_EMAIL="name.surname@student.ius.edu.ba"

# Site URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Event attendance QR signing secret: at least 32 random characters, for example the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Check-in refuses to work while this is missing or still the placeholder below.
QR_HMAC_SECRET="change-this-to-a-secure-random-secret-key-32-chars-min"
